rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && 
        isEmailVerified() &&
        request.auth.token.email in [
          'redmunlight@gmail.com', 
          'ahbiyout@gmail.com', 
          'ahbiyoutwinfixwizard@gmail.com',
          'ahbiyoutwinfix@gmail.com'
        ];
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for Issue entity
    function isValidIssue(data) {
      // More lenient validation to prevent PERMISSION_DENIED on valid AI outputs
      return data.keys().hasAll(['category', 'code', 'title', 'symptoms']) &&
             data.category is string && data.category.size() <= 200 &&
             data.code is string && data.code.size() <= 500 &&
             data.title is string && data.title.size() <= 2000 &&
             data.symptoms is string && data.symptoms.size() <= 50000;
    }

    function isValidSearchLog(data) {
      return data.keys().hasAll(['query']) &&
             data.query is string && data.query.size() <= 300;
    }

    function isValidFeedback(data) {
      return (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000)) &&
             (!('issueId' in data) || (data.issueId is string && data.issueId.size() <= 128));
    }

    function isValidAppErrorLog(data) {
      return data.keys().hasAll(['message', 'severity']) &&
             data.message is string && data.message.size() <= 5000 &&
             data.severity in ['error', 'warning', 'fatal'];
    }

    function isValidVisitorLog(data) {
      return data.keys().hasAll(['visitorId']) &&
             data.visitorId is string && data.visitorId.size() <= 128 &&
             (!('ip' in data) || (data.ip is string && data.ip.size() <= 64)) &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 500));
    }

    // Issues collection
    match /issues/{issueId} {
      allow read: if true; // Public guidebook
      allow create: if isAdmin() && isValidIssue(request.resource.data);
      allow update: if (isAdmin() && isValidIssue(request.resource.data)) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotedBy', 'downvotedBy', 'upvoteCount']) &&
        (!('upvotedBy' in request.resource.data) || (request.resource.data.upvotedBy is list && request.resource.data.upvotedBy.size() <= 20000)) &&
        (!('downvotedBy' in request.resource.data) || (request.resource.data.downvotedBy is list && request.resource.data.downvotedBy.size() <= 20000)) &&
        (!('upvoteCount' in request.resource.data) || request.resource.data.upvoteCount is number)
      );
      allow delete: if isAdmin();
    }

    // Issue Bundles for hybrid blob optimization (public read, admin write)
    match /issue_bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Config
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Search Logs
    match /search_logs/{logId} {
      allow create: if isValidId(logId) && isValidSearchLog(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if isValidId(feedbackId) && isValidFeedback(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Admin Logs
    match /admin_logs/{logId} {
      allow read, write, delete: if isAdmin();
    }

    // Application Error Logs
    match /app_error_logs/{logId} {
      allow create: if isValidId(logId) && isValidAppErrorLog(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Bookmarks - User specific
    match /bookmarks/{bookmarkId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // User Activities - History/Tracking
    match /user_activities/{activityId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || (!isSignedIn() && !('userId' in request.resource.data));
    }

    // AI Config & Knowledge
    match /ai_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Backend logs for autonomous sync engine
    match /backend_logs/{logId} {
      allow read, delete: if isAdmin();
      allow write: if false; // Only server (Admin SDK) can write
    }

    // Visitor Logs for visitor tracking and management
    match /visitor_logs/{logId} {
      allow create, update: if isValidId(logId) && isValidVisitorLog(request.resource.data);
      allow read, delete: if isAdmin();
    }
  }
}
