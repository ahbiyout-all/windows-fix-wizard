# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
CUSTOM_API_KEY=""
My_Project_40329=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.

# Google AdSense
VITE_GOOGLE_ADSENSE_CLIENT_ID=
VITE_GOOGLE_ADSENSE_SLOT_ID=

# Automated Sync Webhook & HMAC Signing (Secrets used for GitHub Actions -> App /api/github/sync & /heartbeat)
CRON_SECRET=
GITHUB_WEBHOOK_SECRET=
SHARED_APP_URL=

# Admin Master Passkey (Optional: Set a strong, unique secret passkey with 24+ characters if direct passkey authentication is needed)
ADMIN_PASSKEY=

# SMTP Email Configuration (Optional: Set these if you wish to deliver real email alerts via SMTP relay)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Optional Free-Tier & Trial AI Failover Providers (Server-side only)
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
CEREBRAS_API_KEY=

# Private Admin Repository Encrypted Backup (AES-256-GCM · Server-side only)
ADMIN_BACKUP_GITHUB_TOKEN=
ADMIN_BACKUP_ENCRYPTION_KEY=
